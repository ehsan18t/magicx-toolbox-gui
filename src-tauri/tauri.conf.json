{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagicX Toolbox",
  "version": "3.0.0",
  "identifier": "me.ehsankhan.magicx-toolbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite dev",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MagicX Toolbox",
        "decorations": false,
        "width": 1024,
        "minWidth": 600,
        "height": 700,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0f1c",
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/Toolbox.ico"],
    "publisher": "Ehsan Khan",
    "copyright": "Copyright © 2025 Ehsan Khan"
  }
}
