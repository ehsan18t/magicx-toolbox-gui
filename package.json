{
  "name": "magicx-toolbox",
  "version": "3.0.0",
  "description": "MagicX Toolbox - Windows System Optimization & Tweaking Application",
  "author": "Ehsan Khan <ehsan18t@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ehsan18t/magicx-toolbox-gui"
  },
  "keywords": [
    "tauri",
    "svelte",
    "vite",
    "tailwindcss",
    "starter-template"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:test": "tauri build --features test-build",
    "dev:test": "tauri dev --features test-build",
    "copy-icons": "cpy src-tauri/icons/Toolbox.ico static/icons --flat",
    "postinstall": "pnpm run copy-icons",
    "clean": "rimraf dist src-tauri/target",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "format:rust": "cd src-tauri && cargo fmt",
    "format:rust:check": "cd src-tauri && cargo fmt -- --check",
    "lint": "eslint ./src --max-warnings 0",
    "test": "node --import ./scripts/test-loader.mjs --test \"src/**/*.test.ts\"",
    "lint:fix": "eslint ./src --fix",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "test:rust": "cd src-tauri && cargo test --all-targets --features test-build",
    "lint:rust:fix": "cd src-tauri && cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run format:check && pnpm run test:rust && pnpm run type-check && pnpm run check && pnpm run format:rust:check && pnpm run lint:rust && pnpm run lint && pnpm run test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/fluent": "^1.2.59",
    "@iconify-json/icon-park-twotone": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.41",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.2"
  }
}
